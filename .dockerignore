.env.*
!.env.example

# Instalador do CNIS runner (~350MB). Fica de fora por padrao.
# Para embutir o .exe na imagem, comente as 2 linhas abaixo e suba
# INCLUDE_CNIS_INSTALLER=true (veja docs/deploy-vps-docker.md).
tools/cnis-runner/installer-parts
public/downloads

# Runtime local do runner / lixo de dev
