# Variaveis do build da imagem Docker do frontend.
# Copie para .env.docker e ajuste:  cp .env.docker.example .env.docker
#
# ATENCAO: tudo aqui e embutido no bundle JS que vai pro navegador.
# Nunca coloque service_role key, senha de banco ou chave de API paga aqui.
# Trocar qualquer valor exige rebuild da imagem (nao e config de runtime).

VITE_SUPABASE_URL="https://zaobtetbjpuzibjymhzw.supabase.co"
VITE_SUPABASE_PROJECT_ID="zaobtetbjpuzibjymhzw"
# Chave anon/publishable do projeto (a mesma do .env local; e publica por design).
VITE_SUPABASE_PUBLISHABLE_KEY="cole-a-chave-publishable-aqui"

# CNIS runner: e um app Windows que roda na maquina do usuario, falando com
# 127.0.0.1:8787. Em producao web isso nao existe -> deixe false pra esconder
# a UI que depende dele.
VITE_ENABLE_CNIS_RUNNER=false

# Se for hospedar o instalador (347MB) fora da imagem (S3/R2/outro host),
# aponte a URL aqui. Vazio + INCLUDE_CNIS_INSTALLER=false => o botao de
# download aponta pra /downloads/... e da 404.
VITE_CNIS_RUNNER_WINDOWS_INSTALLER_URL=""

# true = embute o .exe de 347MB na imagem. Exige tambem liberar
# tools/cnis-runner/installer-parts no .dockerignore.
INCLUDE_CNIS_INSTALLER=false
